+package api
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/idena-network/idena-go/common"
+	"github.com/idena-network/idena-go/core/state"
+	"github.com/stretchr/testify/require"
+	dbm "github.com/tendermint/tm-db"
+)
+
+func TestCreateEpochIdentityProofFromCommittedState(t *testing.T) {
+	stateDB, err := state.NewLazy(dbm.NewMemDB())
+	require.NoError(t, err)
+	address := common.HexToAddress("0x1111111111111111111111111111111111111111")
+	stake, ok := new(big.Int).SetString("500000000000000000000000", 10)
+	require.True(t, ok)
+	stateDB.AddStake(address, stake)
+	stateDB.SetState(address, state.Human)
+	stateDB.Precommit(true)
+	_, _, err = stateDB.CommitTree(42)
+	require.NoError(t, err)
+
+	readonly, err := stateDB.Readonly(42)
+	require.NoError(t, err)
+	blockHash := common.HexToHash("0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+	proof, err := createEpochIdentityProof(readonly, 42, blockHash, address)
+	require.NoError(t, err)
+	require.Equal(t, uint64(42), proof.Height)
+	require.Equal(t, blockHash, proof.BlockHash)
+	require.Equal(t, readonly.Root(), proof.StateRoot)
+	require.Equal(t, address, proof.Address)
+	require.Equal(t, stake.String(), proof.Stake)
+	require.Equal(t, uint16(state.Human), proof.State)
+	require.Equal(t, "Human", proof.StateName)
+	require.NotEmpty(t, proof.Value)
+	require.Equal(t, state.StateDbKeys.IdentityKey(address), []byte(proof.Leaf.Key))
+}
+
+func TestCreateEpochIdentityProofWithZeroStake(t *testing.T) {
+	stateDB, err := state.NewLazy(dbm.NewMemDB())
+	require.NoError(t, err)
+	address := common.HexToAddress("0x2222222222222222222222222222222222222222")
+	stateDB.SetState(address, state.Newbie)
+	stateDB.Precommit(true)
+	_, _, err = stateDB.CommitTree(42)
+	require.NoError(t, err)
+
+	readonly, err := stateDB.Readonly(42)
+	require.NoError(t, err)
+	proof, err := createEpochIdentityProof(readonly, 42, common.Hash{}, address)
+	require.NoError(t, err)
+	require.Equal(t, "0", proof.Stake)
+	require.Equal(t, uint16(state.Newbie), proof.State)
+}
+
+func TestCreateEpochCheckpointFromCommittedState(t *testing.T) {
+	stateDB, err := state.NewLazy(dbm.NewMemDB())
+	require.NoError(t, err)
+	stateDB.SetGlobalEpoch(43)
+	stateDB.Precommit(true)
+	_, _, err = stateDB.CommitTree(42)
+	require.NoError(t, err)
+
+	readonly, err := stateDB.Readonly(42)
+	require.NoError(t, err)
+	blockHash := common.HexToHash("0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
+	checkpoint, err := createEpochCheckpoint(readonly, 42, blockHash)
+	require.NoError(t, err)
+	require.Equal(t, uint64(42), checkpoint.Height)
+	require.Equal(t, blockHash, checkpoint.BlockHash)
+	require.Equal(t, readonly.Root(), checkpoint.StateRoot)
+	require.Equal(t, uint16(43), checkpoint.Epoch)
+	require.Equal(t, state.StateDbKeys.GlobalKey(), []byte(checkpoint.EpochProof.Leaf.Key))
+	require.NotEmpty(t, checkpoint.EpochProof.Value)
+}

