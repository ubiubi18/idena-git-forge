+	State     uint16                   `json:"state"`
+	StateName string                   `json:"stateName"`
+	Leaf      EpochIdentityProofLeaf   `json:"leaf"`
+	Path      []EpochIdentityProofItem `json:"path"`
+}
+
+// EpochIdentityProof returns a historical membership proof for the identity
+// record committed by a ValidationFinished block. It is read-only and
+// deliberately bounded to the node's retained state window.
+func (api *DnaApi) EpochIdentityProof(args EpochIdentityProofArgs) (*EpochIdentityProof, error) {
+	header := api.bc.GetBlockHeaderByHeight(args.Height)
+	if header == nil {
+		return nil, errors.Errorf("block %d not found", args.Height)
+	}
+	if args.BlockHash == (common.Hash{}) {
+		return nil, errors.New("block hash is required")
+	}
+	if header.Hash() != args.BlockHash {
+		return nil, errors.New("block hash does not match canonical block at height")
+	}
+	if !header.Flags().HasFlag(types.ValidationFinished) {
+		return nil, errors.New("requested block is not a ValidationFinished checkpoint")
+	}
+	appState, err := api.baseApi.engine.ReadonlyAppStateAt(args.Height)
+	if err != nil {
+		return nil, errors.Wrap(err, "load historical state")
+	}
+	stateRoot := appState.State.Root()
+	if stateRoot != header.Root() {
+		return nil, errors.New("historical state root does not match block header")
+	}
+	return createEpochIdentityProof(appState.State, args.Height, header.Hash(), args.Address)
+}
+
+func createEpochIdentityProof(stateDB *state.StateDB, height uint64, blockHash common.Hash, address common.Address) (*EpochIdentityProof, error) {
+	proofBytes, err := stateDB.GetIdentityWithProof(address)
+	if err != nil {
+		return nil, errors.Wrap(err, "create identity proof")
+	}
+	proof, err := decodeValueProof(proofBytes, "identity")
+	if err != nil {
+		return nil, err
+	}
+	identity := new(state.Identity)
+	if err := identity.FromBytes(proof.Value); err != nil {
+		return nil, errors.Wrap(err, "decode identity state")
+	}
+	stake := new(big.Int)
+	if identity.Stake != nil {
+		stake.Set(identity.Stake)
+	}
+	res := &EpochIdentityProof{
+		Height:    height,
+		BlockHash: blockHash,
+		StateRoot: stateDB.Root(),
+		Address:   address,
+		Value:     proof.Value,
+		Stake:     stake.String(),
+		State:     uint16(identity.State),
+		StateName: identityStateName(identity.State),
+		Leaf: EpochIdentityProofLeaf{
+			Key:       proof.Leaf.Key,
+			ValueHash: proof.Leaf.ValueHash,
+			Version:   proof.Leaf.Version,
+		},
+		Path: make([]EpochIdentityProofItem, 0, len(proof.Proof)),
+	}
+	for _, item := range proof.Proof {
+		res.Path = append(res.Path, EpochIdentityProofItem{
+			Height:  int16(item.Height),
+			Size:    item.Size,
+			Version: item.Version,
+			Left:    item.Left,
+			Right:   item.Right,
+		})
+	}
+	return res, nil
+}
+
+func decodeValueProof(proofBytes []byte, label string) (*models.ValueWithProof, error) {
+	if len(proofBytes) == 0 {
+		return nil, errors.Errorf("%s does not exist at checkpoint", label)
+	}
+	proof := new(models.ValueWithProof)
+	if err := proto.Unmarshal(proofBytes, proof); err != nil {
+		return nil, errors.Wrapf(err, "decode %s proof", label)
+	}
+	if proof.Leaf == nil {
+		return nil, errors.Errorf("%s proof has no leaf", label)
+	}
+	return proof, nil
+}
+
+func valueProofResponse(proof *models.ValueWithProof) EpochValueProof {
+	result := EpochValueProof{
+		Value: proof.Value,
+		Leaf: EpochIdentityProofLeaf{
+			Key:       proof.Leaf.Key,
+			ValueHash: proof.Leaf.ValueHash,
+			Version:   proof.Leaf.Version,
+		},
+		Path: make([]EpochIdentityProofItem, 0, len(proof.Proof)),
+	}
+	for _, item := range proof.Proof {
+		result.Path = append(result.Path, EpochIdentityProofItem{
+			Height:  int16(item.Height),
+			Size:    item.Size,
+			Version: item.Version,
+			Left:    item.Left,
+			Right:   item.Right,
+		})
+	}
+	return result
+}
+
+func identityStateName(value state.IdentityState) string {
+	switch value {
+	case state.Invite:
+		return "Invite"
+	case state.Candidate:
+		return "Candidate"
+	case state.Verified:
+		return "Verified"
+	case state.Suspended:
+		return "Suspended"
+	case state.Killed:
+		return "Killed"
+	case state.Zombie:
+		return "Zombie"
+	case state.Newbie:
+		return "Newbie"
+	case state.Human:
+		return "Human"
+	default:
+		return "Undefined"
+	}
+}
