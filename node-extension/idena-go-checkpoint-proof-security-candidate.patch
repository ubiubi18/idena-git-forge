+	Right   hexutil.Bytes `json:"right,omitempty"`
+}
+
+type EpochValueProof struct {
+	Value hexutil.Bytes            `json:"value"`
+	Leaf  EpochIdentityProofLeaf   `json:"leaf"`
+	Path  []EpochIdentityProofItem `json:"path"`
+}
+
+func createEpochCheckpoint(stateDB *state.StateDB, height uint64, blockHash common.Hash) (*EpochCheckpoint, error) {
+	proofBytes, err := stateDB.GetGlobalWithProof()
+	if err != nil {
+		return nil, errors.Wrap(err, "create global epoch proof")
+	}
+	proof, err := decodeValueProof(proofBytes, "global epoch")
+	if err != nil {
+		return nil, err
+	}
+	global := new(state.Global)
+	if err := global.FromBytes(proof.Value); err != nil {
+		return nil, errors.Wrap(err, "decode global epoch state")
+	}
+	if global.Epoch != stateDB.Epoch() {
+		return nil, errors.New("global epoch proof differs from historical state")
+	}
+	return &EpochCheckpoint{
+		Height:     height,
+		BlockHash:  blockHash,
+		StateRoot:  stateDB.Root(),
+		Epoch:      global.Epoch,
+		EpochProof: valueProofResponse(proof),
+	}, nil
+}
